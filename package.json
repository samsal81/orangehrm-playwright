{
  "name": "orangehrm-playwright",
  "version": "1.0.0",
  "description": "Spec-driven TypeScript Playwright testing framework for OrangeHRM",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:smoke": "playwright test --grep @smoke",
    "test:auth": "playwright test tests/auth",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://opensource-demo.orangehrmlive.com/web/index.php/auth/login",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "orangehrm",
    "e2e",
    "automation"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@speckit/spectest": "^0.1.4",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.0"
  }
}
